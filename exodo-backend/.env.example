# ═══════════════════════════════════════════════════════════════════
# ÉXODO BY BEHAVIOR — Configuración del Backend
# Copiar a .env y rellenar con valores reales.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# Servidor / Red
# ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# ─────────────────────────────────────────────────────────────────
# Supabase (Autenticación y Base de Datos)
# ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────
# API keys de proveedores de IA
# ─────────────────────────────────────────────────────────────────
# OpenAI (gpt-4o-mini para G1.1 y Visión)
OPENAI_API_KEY=sk-proj-...

# DeepSeek (deepseek-chat / deepseek-reasoner para Hazak y tareas de backend)
DEEPSEEK_API_KEY=sk-...
# === STRIPE ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

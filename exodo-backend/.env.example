# ═══════════════════════════════════════════════════════════════════
# ÉXODO BY BEHAVIOR — Configuración del Backend
# Copiar a .env y rellenar con valores reales.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# Servidor / Red
# ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# ─────────────────────────────────────────────────────────────────
# Supabase (Autenticación y Base de Datos)
# ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────
# API keys de proveedores de IA
# ─────────────────────────────────────────────────────────────────
# OpenAI (gpt-4o-mini para G1.1 y Visión)
OPENAI_API_KEY=sk-proj-...

# DeepSeek (deepseek-chat / deepseek-reasoner para Hazak y tareas de backend)
DEEPSEEK_API_KEY=sk-...
# === STRIPE ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Precio mensual Hazak (price_xxx real de producción; el fallback en código es el price de pruebas $0.50)
STRIPE_PRICE_ID_MONTHLY=price_xxx

# === BUSQUEDA WEB VIVA (cadena failover Serper->Brave->Tavily->Exa->Jina, $0) ===
WEB_SEARCH_ENABLED=true
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
WEB_SEARCH_MONTHLY_CAP=4400
WEB_SEARCH_FREE_DAILY=5
WEB_SEARCH_PRO_DAILY=30
WEB_SEARCH_CACHE_DAYS=7
# Comodin DeepSeek (NO activar hasta el backend real sin Alibaba)
WEB_SEARCH_DEEPSEEK_ENABLED=false
